# eza (ls replacement)
alias ls='eza'
alias l='eza -lh --git'
alias ll='eza -lh --git'
alias la='eza -lah --git'
alias lt='eza --tree'

# bat (cat replacement)
alias cat='bat'

# disk & system
alias du='dust'
alias top='btop'

# git
alias lg='lazygit'

# config shortcuts
alias zshconfig='nvim ~/.config/zsh'

# neovim profiles
alias lzv='NVIM_APPNAME=nvim-lazyvim nvim'
alias asv='NVIM_APPNAME=nvim-astro nvim'
alias ksv='NVIM_APPNAME=nvim-kickstart nvim'
