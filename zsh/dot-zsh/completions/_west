# ---------------------------------------------------------------------------
# west twister — improved over the upstream version:
#
#   * Repeatable flags (-p, -t, -e, -T, -x, --coverage-platform) marked with *
#   * Mutual exclusions encoded (-G vs --emulation-only, --valgrind vs --asan,
#     -N vs -k, -s/--test vs --sub-test, -m vs --compare-report)
#   * Optional values for --report-summary, --footprint-report, -M
#   * ~17 missing options added (--simulation, --west-flash-cmd, --ctest-args, …)
#   * --device-serial completes /dev/tty* instead of all files
#   * Platform completion goes through _get_west_boards (cached above)
# ---------------------------------------------------------------------------
_west_twister() {
  local curcontext="$curcontext"

  local -a simulation_vals
  simulation_vals=(mdb-nsim nsim renode qemu tsim armfvp xt-sim native custom simics whisper)

  local -a log_level_vals
  log_level_vals=(NOTSET DEBUG INFO WARNING ERROR CRITICAL)

  local -a coverage_tool_vals
  coverage_tool_vals=(lcov gcovr)

  local -a filter_vals
  filter_vals=(buildable runnable)

  local -a footprint_vals
  footprint_vals=(all ROM RAM)

  local -a flash_cmd_vals
  flash_cmd_vals=(flash debug)

  # _arguments spec mini-language recap:
  #
  #   FLAG_SPEC[description]:arg_label:ACTION
  #
  #   (a b)--foo   mutual exclusion: --foo suppresses a and b from the menu
  #   *--foo       repeatable flag
  #   --foo=       value follows directly (--foo=VALUE) or as next word
  #   -f+          value concatenated (-fVALUE) or space-separated (-f VALUE)
  #   ::label:ACT  optional value (single : = required)
  #   (word list)  inline fixed-choice completions
  #   _files -/    directories only
  #   _files -W /dev -g "tty*"  glob-filtered under a specific dir
  #   (-)--        the -- separator; suppresses all further flag completion
  #
  #   -s  allow stacked single-letter flags (-abc = -a -b -c)
  #   -S  stop completing flags after the first non-flag argument

  _arguments -s -S \
    '(-h --help)'{-h,--help}'[show this help message and exit]' \
    \
    + '(integration)' \
    '(-G --integration --emulation-only)'{-G,--integration}'[run integration tests]' \
    '(-G --integration --emulation-only)--emulation-only[only build and run emulation platforms]' \
    \
    + misc \
    "--simulation=[select simulation type]:simulation:(${simulation_vals[*]})" \
    \
    + device \
    '--device-testing[test on device directly]' \
    '--pre-script=[script to run before opening serial port]:script:_files' \
    '--device-serial=[serial device for accessing the board]:device:{_files -W /dev -g "tty*"}' \
    '--device-serial-baud=[serial baud rate (default 115200)]:baud rate: ' \
    '--device-serial-pty=[script for controlling pseudoterminal]:script:_files' \
    '--generate-hardware-map=[probe serial devices and write hardware map]:output file:_files' \
    '--hardware-map=[load hardware map from file]:hardware map file:_files' \
    '--persistent-hardware-map[use persistent names for serial devices]' \
    '--device-flash-with-test[add test timeout to flash operation timeout]' \
    '--device-flash-timeout=[timeout for device flash operation in seconds]:seconds: ' \
    '--flash-before[flash device before attaching to serial port]' \
    '--flash-command=[custom flash command instead of west flash]:command: ' \
    '--west-flash=[additional flags passed to west flash]:: ' \
    '--west-runner=[west runner to use with --west-flash]:runner: ' \
    "--west-flash-cmd=[west command to use for flashing]:command:(${flash_cmd_vals[*]})" \
    \
    + platform_filter \
    '(-a --arch)'{-a+,--arch=}'[filter by architecture]:arch: ' \
    '--vendor=[filter by vendor]:vendor: ' \
    '*'{-p+,--platform=}'[filter by platform (repeatable)]:platform:_get_west_boards' \
    '*'{-P+,--exclude-platform=}'[exclude platform (repeatable)]:platform:_get_west_boards' \
    '--platform-pattern=[platform regex filter (repeatable)]:pattern: ' \
    '--test-pattern=[test name regex filter]:pattern: ' \
    "--filter=[filter tests to build/run]:filter:(${filter_vals[*]})" \
    '(-l --all)'{-l,--all}'[build/run on all platforms]' \
    '(-K --force-platform)'{-K,--force-platform}'[force testing on selected platforms]' \
    '--ignore-platform-key[do not filter based on platform key]' \
    '--level=[test level for filtering]:level: ' \
    \
    + tag_filter \
    '*'{-t+,--tag=}'[restrict tests by tag (repeatable, logical or)]:tag: ' \
    '*'{-e+,--exclude-tag=}'[exclude tests with this tag (repeatable)]:tag: ' \
    \
    + test_selection \
    '(-F --load-tests)'{-F+,--load-tests=}'[load tests and platforms from JSON file]:json file:_files -g "*.json"' \
    '*'{-T+,--testsuite-root=}'[base directory to search for test cases (repeatable)]:directory:_files -/' \
    '(-f --only-failed)'{-f,--only-failed}'[run only tests that failed the previous run]' \
    '(--sub-test)'{-s+,--test=,--scenario=}'[run only the specified test scenario]:test: ' \
    '(-s --test --scenario)--sub-test=[recursively find sub-test functions]:sub-test: ' \
    \
    + build \
    '(-b --build-only)'{-b,--build-only}'[only build, do not run]' \
    '--prep-artifacts-for-testing[generate artifacts for testing, do not run]' \
    '--package-artifacts=[package artifacts for flashing into file]:output file:_files' \
    '--test-only[only run device tests with current artifacts]' \
    '--cmake-only[only run cmake, do not build or run]' \
    '(-N --ninja -k --make)'{-N,--ninja}'[use Ninja generator with CMake (default)]' \
    '(-N --ninja -k --make)'{-k,--make}'[use unix Makefile generator with CMake]' \
    '--short-build-path[create shorter build directory paths via symlinks]' \
    '--force-toolchain[do not filter based on toolchain]' \
    '*'{-x+,--extra-args=}'[extra CMake cache entries (repeatable)]:KEY=VALUE: ' \
    '*'{-A+,--board-root=}'[directory to search for board config files (repeatable)]:directory:_files -/' \
    '--alt-config-root=[alternative test configuration root]:directory:_files -/' \
    '--test-config=[path to file with plans and test configurations]:config file:_files' \
    \
    + parallelism \
    '(-j --jobs)'{-j+,--jobs=}'[number of parallel build jobs]:jobs: ' \
    '(-B --subset)'{-B+,--subset=}'[only run a subset of tests (e.g. 1/4)]:subset: ' \
    '--shuffle-tests[shuffle test execution order for --subset]' \
    '--shuffle-tests-seed=[seed for --shuffle-tests]:seed: ' \
    \
    + sanitizers \
    '(--enable-valgrind --enable-asan)--enable-valgrind[run binary through valgrind]' \
    '(--enable-valgrind --enable-asan)--enable-asan[enable address sanitizer]' \
    '--enable-lsan[enable leak sanitizer (requires --enable-asan)]' \
    '--enable-ubsan[enable undefined behavior sanitizer]' \
    \
    + output \
    '(-O --outdir)'{-O+,--outdir=}'[output directory for logs and binaries]:directory:_files -/' \
    '(-o --report-dir)'{-o+,--report-dir=}'[output directory for test reports]:directory:_files -/' \
    '(-c --clobber-output)'{-c,--clobber-output}'[delete output dir instead of renaming]' \
    '(-n --no-clean)'{-n,--no-clean}'[re-use outdir before building (incremental)]' \
    '--aggressive-no-clean[re-use outdir and skip cmake re-run (faster but risky)]' \
    '--detailed-test-id[compose test suite name from config path and scenario]' \
    '--no-detailed-test-id[use scenario name only (no path prefix)]' \
    '--detailed-skipped-report[include all skipped tests in report]' \
    \
    + reporting \
    '(-E --save-tests)'{-E+,--save-tests=}'[write test plan to file and exit]:output file:_files' \
    '--list-tests[list all sub-test functions and exit]' \
    '--test-tree[output test plan as a tree]' \
    '--list-tags[list all tags and exit]' \
    '--overflow-as-errors[treat RAM/SRAM overflows as errors]' \
    '--report-filtered[include filtered tests in reports]' \
    '--platform-reports[create individual reports per platform]' \
    '--quarantine-list=[load quarantine list from file]:quarantine file:_files' \
    '--quarantine-verify[run quarantined tests to verify status]' \
    '--quit-on-failure[quit on first build or run failure]' \
    '--report-name=[custom report name]:name: ' \
    '--report-summary=[show failed/error report from latest run]::count: ' \
    '--report-suffix=[suffix added to all generated file names]:suffix: ' \
    '--report-all-options[include all options (incl. defaults) in twister.json]' \
    '--disable-suite-name-check[disable extended test suite name verification]' \
    \
    + retry \
    '--retry-failed=[retry failing tests N times]:count: ' \
    '--retry-interval=[retry failing tests after N seconds]:seconds: ' \
    '--retry-build-errors[retry build errors as well]' \
    \
    + slow \
    '(-S --enable-slow)'{-S,--enable-slow}'[execute tests marked as slow]' \
    '--enable-slow-only[execute only tests marked as slow]' \
    '--seed=[seed for native_sim PRNG]:seed: ' \
    \
    + runtime \
    '--timeout-multiplier=[globally multiply test timeouts by factor]:multiplier: ' \
    '--pytest-args=[additional arguments for pytest subprocess]:args: ' \
    '--ctest-args=[additional arguments for ctest subprocess]:args: ' \
    '--allow-installed-plugin[allow pytest plugins installed via pip]' \
    '(-X --fixture)'{-X+,--fixture=}'[fixture that a board supports]:fixture: ' \
    '--force-color[always output ANSI color escape sequences]' \
    \
    + cleanup \
    '(-M --runtime-artifact-cleanup)'{-M,--runtime-artifact-cleanup}'[cleanup test artifacts at runtime]::policy:(pass all)' \
    '--keep-artifacts=[keep specified artifacts when cleaning (repeatable)]:artifact: ' \
    \
    + logging \
    '(-i --inline-logs)'{-i,--inline-logs}'[print log data to stdout on failure]' \
    '--log-file=[save logs to file]:log file:_files' \
    "--log-level=[-ll]:log level:(${log_level_vals[*]})" \
    "-ll[log level threshold]:log level:(${log_level_vals[*]})" \
    '--timestamps[print all messages with timestamps]' \
    '(-v --verbose)'{-v,--verbose}'[increase verbosity (repeatable)]' \
    '(-u --no-update)'{-u,--no-update}'[do not update results of last run]' \
    '(-W --disable-warnings-as-errors)'{-W,--disable-warnings-as-errors}'[do not treat warnings as errors]' \
    '(-y --dry-run)'{-y,--dry-run}'[create filtered test list but do not run]' \
    \
    + footprint \
    '--create-rom-ram-report[generate detailed ROM/RAM symbol size JSON reports]' \
    "--footprint-report=[collect memory area symbols data]::area:(${footprint_vals[*]})" \
    '--enable-size-report[collect and report ROM/RAM section sizes]' \
    '--footprint-from-buildlog[take ROM/RAM footprint from build.log]' \
    '(-m --last-metrics --compare-report)'{-m,--last-metrics}'[compare footprints to previous run]' \
    '(-m --last-metrics --compare-report)--compare-report=[use report file as footprint baseline]:baseline file:_files -g "*.json"' \
    '--show-footprint[log ROM/RAM section deltas with footprint comparison]' \
    '(-H --footprint-threshold)'{-H+,--footprint-threshold=}'[warn on footprint change >= this %]:percent: ' \
    '(-D --all-deltas)'{-D,--all-deltas}'[warn on any footprint change (implies --footprint-threshold=0)]' \
    '(-z --size)'{-z+,--size=}'[report ROM/RAM sizes for binary images]:binary:_files' \
    \
    + coverage \
    '--enable-coverage[enable code coverage collection using gcov]' \
    '(-C --coverage)'{-C,--coverage}'[generate coverage reports (implies --enable-coverage)]' \
    '--gcov-tool=[path to gcov tool]:gcov tool:_files' \
    '--coverage-basedir=[base source directory for coverage report]:directory:_files -/' \
    '*--coverage-platform=[platform to run coverage on (repeatable)]:platform:_get_west_boards' \
    "--coverage-tool=[tool to generate coverage reports]:tool:(${coverage_tool_vals[*]})" \
    '--coverage-formats=[comma-separated output formats for coverage]:formats: ' \
    '--coverage-per-instance[compose individual coverage reports per test suite]' \
    '--disable-coverage-aggregation[disable aggregated coverage report]' \
    \
    + passthrough \
    '(-)--[pass remaining arguments to test binary]: :' \
    '*::extra test args: '
}

_west_simulate() {
  __comp_west_runner_cmd
}

_west_reset() {
  __comp_west_runner_cmd
}

_west_rtt() {
  local -a opts=(
  '(-d --build-dir)'{-d,--build-dir}'[build directory]:build dir:_directories'
  '(-s --serial-pty)'{-s,--serial-pty}'[serial PTY]:pty:_files'
  )

  _arguments -S $opts
}

_west_zephyr-export() {
  _arguments -S
}

_west_bindesc() {
  local -a subcommands=(
  'dump:Dump all binary descriptors in the image'
  'extract:Extract the binary descriptor blob to a file'
  'search:Search for a specific descriptor'
  'custom_search:Search for a custom descriptor'
  'list:List all known descriptors'
  'get_offset:Get the offset of the descriptors'
  )

  local context state line
  typeset -A opt_args

  _arguments -S -C \
    '1:subcommand:->subcmds' \
    '*::arg:->args'

  case $state in
  subcmds)
    _describe 'subcommands' subcommands
    ;;
  args)
    curcontext="${curcontext%:*:*}:west-bindesc-${line[1]}:"
    _call_function ret _west_bindesc_${line[1]}
    ;;
  esac
}

_west_bindesc_dump()          { _arguments -S '*:image:_files' }
_west_bindesc_extract()       { _arguments -S '*:image:_files' }
_west_bindesc_search()        { _arguments -S '*:image:_files' }
_west_bindesc_custom_search() { _arguments -S '*:image:_files' }
_west_bindesc_list()          { _arguments -S '*:image:_files' }
_west_bindesc_get_offset()    { _arguments -S '*:image:_files' }

