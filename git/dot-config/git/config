# mostly taken from 
# https://micahkepe.com/blog/gitconfig/
# https://blog.gitbutler.com/how-git-core-devs-configure-git
#
[init]
	defaultBranch = main

[user]
	email = tobias.kaestner@inovex.de
	name = Tobias Kaestner

[branch]
  sort = -committerdate

[tag]
  sort = -version:refname

[column]
  ui = auto

[status]
  branch = true
  showStash = true

[advice]
  statusHints = false

[core]
	pager = delta
  editor = nvim
	hooksPath = ~/.config/git/hooks

[commit]
  verbose = true

[interactive]
	diffFilter = delta --color-only
  singleKey = true

[delta]
	navigate = true
	side-by-side = true
	line-numbers = true
	syntax-theme = Monokai Extended
	file-style = bold yellow ul
	file-decoration-style = none
	hunk-header-style = file line-number syntax
	hunk-header-decoration-style = blue box
	hyperlinks = true

[rebase]
  autoStash = true
  autoSquash = true
  missingCommitsCheck = warn
  updateRefs = true

[merge]
	conflictStyle = zdiff3
	tool = nvimdiff-lazyvim

[fetch]
  prune = true
  #pruneTags = true
  all = true

[pull]
  rebase = true
  default = current

[push]
  autoSetupRemote = true
  default = current

[diff]
  algorithm = histogram
  colorMoved = plain
  mnemonicPrefix = true
  renames = true
  tool = difftastic

[difftool]
  prompt = false

[difftool "difftastic"]
  cmd = difft "$LOCAL" "$REMOTE"

[difftool "nvimdiff-lazyvim"]
  cmd = nvimdiff-lazyvim "$LOCAL" "$REMOTE"

[mergetool]
  prompt = false
  keepBackup = false

[mergetool "nvimdiff-lazyvim"]
  cmd = nvimdiff-lazyvim -c "wincmd J" "$LOCAL" "$MERGED" "$REMOTE"

[alias]
  dft = difftool
  nv = difftool --tool=nvimdiff-lazyvim
  lg = log --graph --pretty=format:'%C(bold blue)%h%C(reset) - %C(bold green)(%ar)%C(reset) %s %C(dim white)- %an%C(reset)%C(bold yellow)%d%C(reset)' --abbrev-commit
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
